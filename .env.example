# From Supabase: Project Settings -> API (or "Connect" button)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Public base URL of this app (used in signup confirmation emails and QR codes)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Razorpay (server only; leave empty to keep online payments in test mode / off)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
